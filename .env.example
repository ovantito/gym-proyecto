# Copia a .env y completa. NUNCA subas .env al repositorio.

# --- Supabase (si SUPABASE_URL o SUPABASE_SECRET_KEY están vacíos, el backend usa memoria) ---
SUPABASE_URL=                  # https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_...  pública; solo para el login del panel
SUPABASE_SECRET_KEY=           # sb_secret_...  SECRETA: solo backend/.env y Render; NUNCA en estacion/ ni panel-coach/
SUPABASE_JWKS_URL=             # opcional: por defecto <SUPABASE_URL>/auth/v1/.well-known/jwks.json (claves ES256 de Supabase)
SUPABASE_JWT_SECRET=           # opcional: solo para tokens HS256 (modo demo / secreto legado)
JWT_AUDIENCE=authenticated

# --- Seguridad HTTP ---
CORS_ORIGINS=                # ej: https://panel.tntgym.pe,https://estacion.tntgym.pe
                             # vacío = en ENTORNO=dev solo http://localhost:5173; en otro entorno, ninguno
ENTORNO=dev
RATE_LIMIT_DEFECTO=120/minute
RATE_LIMIT_SESIONES=10/minute

# --- Modelos ---
MODO_OFFLINE=false           # true = Hill Climbing en vez de A*
ZONA_HORARIA=America/Lima

# --- Demo en memoria ---
SEMILLA_DEMO=true
DEMO_STATION_KEY=            # vacío = se genera una al arrancar y se imprime en consola

# --- Cloudflare R2 (videos de ejercicios) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIJO=ejercicios/
