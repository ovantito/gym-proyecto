# Copia a .env y completa. NUNCA subas .env al repositorio.

# --- Supabase (si SUPABASE_URL / SUPABASE_SERVICE_KEY están vacíos, el backend usa memoria) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # service_role: solo en el servidor, jamás en el frontend
SUPABASE_JWT_SECRET=         # Settings > API > JWT Secret
JWT_AUDIENCE=authenticated

# --- Seguridad HTTP ---
CORS_ORIGINS=                # ej: https://panel.tntgym.pe,https://estacion.tntgym.pe
                             # vacío = en ENTORNO=dev solo http://localhost:5173; en otro entorno, ninguno
ENTORNO=dev
RATE_LIMIT_DEFECTO=120/minute
RATE_LIMIT_SESIONES=10/minute

# --- Modelos ---
MODO_OFFLINE=false           # true = Hill Climbing en vez de A*
ZONA_HORARIA=America/Lima

# --- Demo en memoria ---
SEMILLA_DEMO=true
DEMO_STATION_KEY=            # vacío = se genera una al arrancar y se imprime en consola

# --- Cloudflare R2 (videos de ejercicios) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIJO=ejercicios/
